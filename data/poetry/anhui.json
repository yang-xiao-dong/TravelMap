[
 {
  "n": "黄山风景区",
  "poems": [
   {
    "t": "送温处士归黄山白鹅峰旧居",
    "a": "李白",
    "d": "唐",
    "l": "黄山四千仞，三十二莲峰。"
   }
  ]
 },
 {
  "n": "九华山",
  "poems": [
   {
    "t": "望九华赠青阳韦仲堪",
    "a": "李白",
    "d": "唐",
    "l": "昔在九江上，遥望九华峰。天河挂绿水，秀出九芙蓉。"
   }
  ]
 },
 {
  "n": "天柱山",
  "poems": [
   {
    "t": "题天柱峰",
    "a": "白居易",
    "d": "唐",
    "l": "天柱一峰擎日月，洞门千仞锁云雷。"
   },
   {
    "t": "江上望皖公山",
    "a": "李白",
    "d": "唐",
    "l": "奇峰出奇云，秀木含秀气。"
   }
  ]
 },
 {
  "n": "琅琊山",
  "poems": [
   {
    "t": "滁州西涧",
    "a": "韦应物",
    "d": "唐",
    "l": "独怜幽草涧边生，上有黄鹂深树鸣。"
   }
  ]
 }
]