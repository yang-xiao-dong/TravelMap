[
 {
  "n": "白帝城·瞿塘峡",
  "poems": [
   {
    "t": "早发白帝城",
    "a": "李白",
    "d": "唐",
    "l": "朝辞白帝彩云间，千里江陵一日还。"
   },
   {
    "t": "登高",
    "a": "杜甫",
    "d": "唐",
    "l": "无边落木萧萧下，不尽长江滚滚来。"
   }
  ]
 },
 {
  "n": "巫峡·神女景区（神女溪/神女天路/文峰观）",
  "poems": [
   {
    "t": "巫山神女庙",
    "a": "刘禹锡",
    "d": "唐",
    "l": "巫山十二郁苍苍，片石亭亭号女郎。"
   }
  ]
 }
]