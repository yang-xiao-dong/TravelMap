[
 {
  "n": "钟山风景区（明孝陵·梅花山）",
  "poems": [
   {
    "t": "泊船瓜洲",
    "a": "王安石",
    "d": "宋",
    "l": "京口瓜洲一水间，钟山只隔数重山。"
   }
  ]
 },
 {
  "n": "瘦西湖",
  "poems": [
   {
    "t": "寄扬州韩绰判官",
    "a": "杜牧",
    "d": "唐",
    "l": "二十四桥明月夜，玉人何处教吹箫。"
   },
   {
    "t": "扬州慢·淮左名都",
    "a": "姜夔",
    "d": "宋",
    "l": "二十四桥仍在，波心荡、冷月无声。"
   }
  ]
 },
 {
  "n": "镇江三山（金山·焦山·北固山）",
  "poems": [
   {
    "t": "次北固山下",
    "a": "王湾",
    "d": "唐",
    "l": "潮平两岸阔，风正一帆悬。"
   },
   {
    "t": "南乡子·登京口北固亭有怀",
    "a": "辛弃疾",
    "d": "宋",
    "l": "何处望神州？满眼风光北固楼。"
   }
  ]
 },
 {
  "n": "花果山",
  "poems": [
   {
    "t": "次韵陈海州书怀",
    "a": "苏轼",
    "d": "宋",
    "l": "郁郁苍梧海上山，蓬莱方丈有无间。"
   }
  ]
 }
]