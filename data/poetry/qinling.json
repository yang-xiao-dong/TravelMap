[
 {
  "n": "南五台 · 终南山",
  "poems": [
   {
    "t": "终南山",
    "a": "王维",
    "d": "唐",
    "l": "太乙近天都，连山接海隅。"
   },
   {
    "t": "下终南山过斛斯山人宿置酒",
    "a": "李白",
    "d": "唐",
    "l": "暮从碧山下，山月随人归。"
   }
  ]
 },
 {
  "n": "太白山国家森林公园",
  "poems": [
   {
    "t": "登太白峰",
    "a": "李白",
    "d": "唐",
    "l": "太白与我语，为我开天关。"
   }
  ]
 },
 {
  "n": "华山风景名胜区",
  "poems": [
   {
    "t": "西岳云台歌送丹丘子",
    "a": "李白",
    "d": "唐",
    "l": "西岳峥嵘何壮哉！黄河如丝天际来。"
   },
   {
    "t": "望岳·其二",
    "a": "杜甫",
    "d": "唐",
    "l": "西岳崚嶒竦处尊，诸峰罗立似儿孙。"
   }
  ]
 },
 {
  "n": "王顺山国家森林公园",
  "poems": [
   {
    "t": "左迁至蓝关示侄孙湘",
    "a": "韩愈",
    "d": "唐",
    "l": "云横秦岭家何在？雪拥蓝关马不前。"
   }
  ]
 }
]