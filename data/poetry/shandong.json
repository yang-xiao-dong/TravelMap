[
 {
  "n": "泰山",
  "poems": [
   {
    "t": "望岳",
    "a": "杜甫",
    "d": "唐",
    "l": "会当凌绝顶，一览众山小。"
   },
   {
    "t": "游泰山六首·其一",
    "a": "李白",
    "d": "唐",
    "l": "天门一长啸，万里清风来。"
   }
  ]
 },
 {
  "n": "崂山",
  "poems": [
   {
    "t": "寄王屋山人孟大融",
    "a": "李白",
    "d": "唐",
    "l": "我昔东海上，劳山餐紫霞。"
   }
  ]
 },
 {
  "n": "蓬莱阁",
  "poems": [
   {
    "t": "登州海市",
    "a": "苏轼",
    "d": "宋",
    "l": "东方云海空复空，群仙出没空明中。"
   }
  ]
 }
]