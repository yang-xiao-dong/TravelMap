[
 {
  "n": "沙坡头",
  "poems": [
   {
    "t": "使至塞上",
    "a": "王维",
    "d": "唐",
    "l": "大漠孤烟直，长河落日圆。"
   }
  ]
 },
 {
  "n": "潼关",
  "poems": [
   {
    "t": "秋日赴阙题潼关驿楼",
    "a": "许浑",
    "d": "唐",
    "l": "红叶晚萧萧，长亭酒一瓢。"
   },
   {
    "t": "潼关吏",
    "a": "杜甫",
    "d": "唐",
    "l": "士卒何草草，筑城潼关道。"
   }
  ]
 }
]