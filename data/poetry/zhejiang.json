[
 {
  "n": "西湖",
  "poems": [
   {
    "t": "饮湖上初晴后雨",
    "a": "苏轼",
    "d": "宋",
    "l": "欲把西湖比西子，淡妆浓抹总相宜。"
   },
   {
    "t": "钱塘湖春行",
    "a": "白居易",
    "d": "唐",
    "l": "乱花渐欲迷人眼，浅草才能没马蹄。"
   }
  ]
 },
 {
  "n": "钱塘江大潮 · 盐官（海宁）",
  "poems": [
   {
    "t": "浪淘沙·其七",
    "a": "刘禹锡",
    "d": "唐",
    "l": "八月涛声吼地来，头高数丈触山回。"
   },
   {
    "t": "酒泉子·长忆观潮",
    "a": "潘阆",
    "d": "宋",
    "l": "来疑沧海尽成空，万面鼓声中。"
   }
  ]
 },
 {
  "n": "天台山（天台）",
  "poems": [
   {
    "t": "舟中晓望",
    "a": "孟浩然",
    "d": "唐",
    "l": "问我今何适？天台访石桥。"
   }
  ]
 }
]